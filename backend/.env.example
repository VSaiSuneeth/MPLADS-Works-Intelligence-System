# MPLADS Works Intelligence & Review System Environment Configuration Example
PROJECT_NAME="MPLADS Works Intelligence and Review System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="mplads_intelligence_secret_key_demo_prototype_change_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local/demo, PostgreSQL for production)
DATABASE_URL="sqlite:///./mplads_intelligence.db"

# Data Provenance Metadata
DATASET_LABEL="SYNTHETIC_DEMO"
IS_OFFICIAL_DATA=false
SOURCE_TYPE="CONTROLLED_PROTOTYPE"

# Configurable CORS Origins (comma-separated list)
CORS_ORIGINS="https://mplads-works-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173"

# Upload & File Storage
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=100
